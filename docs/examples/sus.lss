  <rows>
   <row>
    <surveyls_survey_id><![CDATA[736100]]></surveyls_survey_id><surveyls_language><![CDATA[en]]></surveyls_language>
    <surveyls_title><![CDATA[System Usability Scale (SUS)]]></surveyls_title>
    <surveyls_description><![CDATA[<p>The System Usability Scale (Brooke, 1996): ten statements rated 1&ndash;5 (strongly disagree &ndash; strongly agree). Wired for StudyAlign: two hidden fields capture the study id and participant token, and the end URL returns the participant to StudyAlign.</p>]]></surveyls_description>
    <surveyls_welcometext><![CDATA[<p>Please rate your experience with the system you just used.</p>]]></surveyls_welcometext>
    <surveyls_endtext><![CDATA[<p>Please click on the following link</p>]]></surveyls_endtext>
    <surveyls_url><![CDATA[http://localhost:8000/{PASSTHRU:SAL_ID}/proceed/{PASSTHRU:SAL_TOKEN}]]></surveyls_url>
    <surveyls_urldescription><![CDATA[Continue the study]]></surveyls_urldescription>
    <surveyls_dateformat><![CDATA[1]]></surveyls_dateformat><surveyls_numberformat><![CDATA[0]]></surveyls_numberformat>
   </row>
  </rows>
 </surveys_languagesettings>
