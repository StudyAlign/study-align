  <rows>
   <row>
    <surveyls_survey_id><![CDATA[728394]]></surveyls_survey_id><surveyls_language><![CDATA[en]]></surveyls_language>
    <surveyls_title><![CDATA[NASA-TLX (Raw / RTLX)]]></surveyls_title>
    <surveyls_description><![CDATA[<p>NASA Task Load Index &ndash; a six-dimension subjective workload measure. This example uses the &ldquo;raw&rdquo; (unweighted) version: each scale is rated 0&ndash;100 and the six ratings are averaged.</p>]]></surveyls_description>
    <surveyls_welcometext><![CDATA[<p>Please rate the workload you experienced during the task you just completed.</p>]]></surveyls_welcometext>
    <surveyls_endtext><![CDATA[<p>Thank you.</p>]]></surveyls_endtext>
    <surveyls_dateformat><![CDATA[1]]></surveyls_dateformat><surveyls_numberformat><![CDATA[0]]></surveyls_numberformat>
   </row>
  </rows>
