  <rows>
   <row><id><![CDATA[1]]></id><qid><![CDATA[1]]></qid><question><![CDATA[<p>For each scale, move the slider to the point that matches your experience of the task you just completed.</p>]]></question><help><![CDATA[Each scale runs from 0 (left) to 100 (right).]]></help><script><![CDATA[]]></script><language><![CDATA[en]]></language></row>
   <row><id><![CDATA[2]]></id><qid><![CDATA[2]]></qid><question><![CDATA[Mental Demand — How mentally demanding was the task? (Very Low – Very High)]]></question><help><![CDATA[]]></help><script><![CDATA[]]></script><language><![CDATA[en]]></language></row>
   <row><id><![CDATA[3]]></id><qid><![CDATA[3]]></qid><question><![CDATA[Physical Demand — How physically demanding was the task? (Very Low – Very High)]]></question><help><![CDATA[]]></help><script><![CDATA[]]></script><language><![CDATA[en]]></language></row>
   <row><id><![CDATA[4]]></id><qid><![CDATA[4]]></qid><question><![CDATA[Temporal Demand — How hurried or rushed was the pace of the task? (Very Low – Very High)]]></question><help><![CDATA[]]></help><script><![CDATA[]]></script><language><![CDATA[en]]></language></row>
   <row><id><![CDATA[5]]></id><qid><![CDATA[5]]></qid><question><![CDATA[Performance — How successful were you in accomplishing what you were asked to do? (Perfect – Failure)]]></question><help><![CDATA[This scale runs good → poor: 0 = perfect, 100 = failure.]]></help><script><![CDATA[]]></script><language><![CDATA[en]]></language></row>
   <row><id><![CDATA[6]]></id><qid><![CDATA[6]]></qid><question><![CDATA[Effort — How hard did you have to work to accomplish your level of performance? (Very Low – Very High)]]></question><help><![CDATA[]]></help><script><![CDATA[]]></script><language><![CDATA[en]]></language></row>
   <row><id><![CDATA[7]]></id><qid><![CDATA[7]]></qid><question><![CDATA[Frustration — How insecure, discouraged, irritated, stressed, and annoyed were you? (Very Low – Very High)]]></question><help><![CDATA[]]></help><script><![CDATA[]]></script><language><![CDATA[en]]></language></row>
  </rows>
