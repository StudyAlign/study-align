# ─────────────────────────────────────────────────────────────────────────
#  StudyAlign — environment template.  Copy to .env and fill in real values:
#      cp .env.example .env
#  .env is gitignored and must NEVER be committed.
# ─────────────────────────────────────────────────────────────────────────

# ── Database (Postgres) ───────────────────────────────────────────────────
POSTGRES_USER=studyalign
POSTGRES_PASSWORD=change-me
POSTGRES_DB=studyalign
# host port -> container 5432
DB_PORT=5433

# ── Backend ───────────────────────────────────────────────────────────────
BACKEND_PORT=8000

# Auth / JWT.  Generate a fresh secret:  openssl rand -hex 32
SECRET_KEY=change-me-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Admin API key (generate a second value):  openssl rand -hex 32
API_ADMIN_KEY=change-me-openssl-rand-hex-32

# Seed admin user created by init_db.py
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PW=change-me

# CORS: comma-separated exact origins (avoid wildcards in production)
CORS_ORIGINS=http://localhost:3000,http://localhost:3366

# URLs / paths
FRONTEND_URL=http://localhost:3000
LOGOS_PATH=/app/uploads/logos

# ── Mail (fastapi-mail) ───────────────────────────────────────────────────
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@example.com
MAIL_FROM_NAME=StudyAlign
MAIL_PORT=587
MAIL_SERVER=

# ── Frontend ports (dev servers) ──────────────────────────────────────────
ADMIN_FRONTEND_PORT=3000
STUDY_FRONTEND_PORT=3366
