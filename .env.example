# ─────────────────────────────────────────────────────────────────────────
#  StudyAlign — environment template.  Copy to .env and fill in real values:
#      cp .env.example .env
#  .env is gitignored and must NEVER be committed.
# ─────────────────────────────────────────────────────────────────────────

# ── Database (Postgres) ───────────────────────────────────────────────────
POSTGRES_USER=studyalign
POSTGRES_PASSWORD=change-me
POSTGRES_DB=studyalign
# host port -> container 5432
DB_PORT=5433

# ── Backend ───────────────────────────────────────────────────────────────
BACKEND_PORT=8000

# Auth / JWT.  Generate a fresh secret:  openssl rand -hex 32
SECRET_KEY=change-me-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Admin API key (generate a second value):  openssl rand -hex 32
API_ADMIN_KEY=change-me-openssl-rand-hex-32

# Seed admin user created by init_db.py
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PW=change-me

# CORS: comma-separated EXACT origins for the admin + study frontends.
CORS_ORIGINS=http://localhost:3000,http://localhost:3366

# Products/prototypes instrumented with study-align-lib log interactions from
# origins you can't enumerate. CORS_ORIGIN_REGEX allows any matching origin (it
# echoes the origin, so it works with credentials — unlike "*"). Leave it unset
# for a locked-down deployment. For a public logging platform, e.g.:
# CORS_ORIGIN_REGEX=https://.*

# URLs / paths
FRONTEND_URL=http://localhost:3000
LOGOS_PATH=/app/uploads/logos

# ── Mail (fastapi-mail) ───────────────────────────────────────────────────
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@example.com
MAIL_FROM_NAME=StudyAlign
MAIL_PORT=587
MAIL_SERVER=

# ── Frontend ports (dev servers) ──────────────────────────────────────────
ADMIN_FRONTEND_PORT=3000
STUDY_FRONTEND_PORT=3366

# ── Surveys / questionnaires ───────────────────────────────────────────────
# StudyAlign integrates with an EXTERNAL survey tool (LimeSurvey or Qualtrics).
# There is nothing to configure here: each study stores its own survey URL and
# API credentials, set in the admin app. The platform does not host a survey
# instance, so no LIMESURVEY_* variables are needed.

# ── Production (docker-compose.prod.yml, served behind Caddy) ──────────────
# Make every `docker compose` command on the server use the prod stack:
# COMPOSE_FILE=docker-compose.prod.yml
#
# Public URLs baked into the frontend builds (build args). Include the trailing
# slash on the study URL — the admin app appends "<study_id>/" to it.
# PUBLIC_BACKEND_URL=https://backend.studyalign.com
# PUBLIC_STUDY_URL=https://studies.studyalign.com/
#
# For production also set the values above to the public hostnames, e.g.:
# CORS_ORIGINS=https://app.studyalign.com,https://studies.studyalign.com
# FRONTEND_URL=https://app.studyalign.com   (used for links in emails -> admin app)
