{
  "compilerOptions": {
    "module": "ES6",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports" : true,
    "target": "ES6",
    "sourceMap": true,
    "outDir": "./dist/",
    "lib": [
      "ES2020.Promise",
      "es6",
      "dom"
    ]
  },
  "exclude": [
    "node_modules"
  ],
  "include": [
    "src/**/*"
  ]
}